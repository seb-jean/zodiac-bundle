{
    "name": "seb-jean/zodiac-bundle",
    "description": "Zodiac sign calculator for Symfony applications.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["zodiac", "astrology", "horoscope", "western zodiac", "chinese zodiac", "symfony", "bundle", "twig"],
    "homepage": "https://github.com/seb-jean/zodiac-bundle",
    "autoload": {
        "psr-4": {
            "SebJean\\ZodiacBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SebJean\\ZodiacBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sébastien Jean",
            "email": "sebastien.jean76@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/translation-contracts": "^3.6"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "symfony/error-handler": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "twig/twig": "^3.30"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
